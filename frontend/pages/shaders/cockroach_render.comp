// Advanced Vulkan Compute Shader for Ultra-Realistic Cockroach Rendering
// File: cockroach_render.comp
#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputTexture;
layout(binding = 1) uniform sampler2D heightMap;
layout(binding = 2) uniform sampler2D normalMap;
layout(binding = 3) uniform sampler2D roughnessMap;

layout(std140, binding = 4) uniform CockroachParams {
    vec3 lightPos;
    vec3 cameraPos;
    float time;
    float aggro;
    mat4 modelMatrix;
    mat4 viewMatrix;
    mat4 projMatrix;
} params;

// Physically Based Rendering functions
vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);
}

float distributionGGX(vec3 N, vec3 H, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    
    float num = a2;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    denom = 3.14159265 * denom * denom;
    
    return num / denom;
}

// Cockroach anatomy SDF (Signed Distance Field)
float cockroachSDF(vec3 p) {
    // Transform to cockroach space
    p = (inverse(params.modelMatrix) * vec4(p, 1.0)).xyz;
    
    // Head (ellipsoid)
    vec3 headPos = p - vec3(0, 0, 3);
    float head = length(headPos / vec3(1.2, 0.8, 1.5)) - 1.0;
    
    // Thorax (cylinder)
    vec3 thoraxPos = p - vec3(0, 0, 0.5);
    float thorax = length(thoraxPos.xy) - 1.2;
    thorax = max(thorax, abs(thoraxPos.z) - 1.0);
    
    // Abdomen (elongated ellipsoid)
    vec3 abdomenPos = p - vec3(0, 0, -2);
    float abdomen = length(abdomenPos / vec3(1.8, 0.8, 3.0)) - 1.0;
    
    return min(min(head, thorax), abdomen);
}

// Realistic cockroach chitin material
vec3 cockroachPBR(vec2 uv, vec3 worldPos, vec3 normal, vec3 viewDir) {
    // Cockroach-specific material properties
    vec3 albedo = vec3(0.08, 0.04, 0.02); // Dark brown base
    
    // Iridescence effect
    float iridescence = pow(1.0 - max(dot(normal, viewDir), 0.0), 2.0);
    vec3 iridescent = vec3(
        0.2 + 0.3 * sin(iridescence * 6.28 + params.time),
        0.3 + 0.4 * sin(iridescence * 6.28 + params.time + 2.0),
        0.1 + 0.2 * sin(iridescence * 6.28 + params.time + 4.0)
    ) * 0.3;
    
    vec3 lightDir = normalize(params.lightPos - worldPos);
    float NdotL = max(dot(normal, lightDir), 0.0);
    
    vec3 color = albedo * NdotL + iridescent * iridescence;
    
    // Aggro mode enhancement
    if (params.aggro > 0.0) {
        vec3 aggroGlow = vec3(1.0, 0.1, 0.0) * params.aggro * 0.5;
        color = mix(color, aggroGlow, params.aggro * 0.3);
    }
    
    return color;
}

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputTexture);
    
    if (coords.x >= size.x || coords.y >= size.y) return;
    
    vec2 uv = vec2(coords) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y *= -1.0;
    
    // Ray casting
    vec4 rayStart = inverse(params.projMatrix * params.viewMatrix) * vec4(ndc, -1.0, 1.0);
    vec4 rayEnd = inverse(params.projMatrix * params.viewMatrix) * vec4(ndc, 1.0, 1.0);
    
    rayStart /= rayStart.w;
    rayEnd /= rayEnd.w;
    
    vec3 rayDir = normalize(rayEnd.xyz - rayStart.xyz);
    vec3 rayOrigin = rayStart.xyz;
    
    // Raymarching against cockroach SDF
    vec3 color = vec3(0.0);
    float t = 0.0;
    
    for (int i = 0; i < 100; i++) {
        vec3 pos = rayOrigin + rayDir * t;
        float dist = cockroachSDF(pos);
        
        if (dist < 0.001) {
            // Calculate surface normal
            vec3 normal = normalize(vec3(
                cockroachSDF(pos + vec3(0.001, 0, 0)) - cockroachSDF(pos - vec3(0.001, 0, 0)),
                cockroachSDF(pos + vec3(0, 0.001, 0)) - cockroachSDF(pos - vec3(0, 0.001, 0)),
                cockroachSDF(pos + vec3(0, 0, 0.001)) - cockroachSDF(pos - vec3(0, 0, 0.001))
            ));
            
            vec3 viewDir = normalize(params.cameraPos - pos);
            vec2 surfaceUV = vec2(atan(pos.x, pos.z) / 6.28 + 0.5, pos.y * 0.5 + 0.5);
            
            color = cockroachPBR(surfaceUV, pos, normal, viewDir);
            break;
        }
        
        if (t > 50.0) break;
        t += max(dist * 0.9, 0.001);
    }
    
    // Tone mapping and gamma correction
    color = color / (color + vec3(1.0));
    color = pow(color, vec3(1.0/2.2));
    
    imageStore(outputTexture, coords, vec4(color, 1.0));
}