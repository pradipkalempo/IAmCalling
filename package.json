{
  "name": "iamcalling",
  "version": "1.0.0",
  "description": "IAMCALLING - Ideology Analyzer and Critical Thinking Platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "mocha tests/**/*.test.js --timeout 10000",
    "test:unit": "mocha tests_new/unit/**/*.test.js",
    "test:integration": "mocha tests_new/integration/**/*.test.js",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "build": "echo 'No build step required'",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "keywords": [
    "critical-thinking",
    "ideology-analyzer",
    "messenger",
    "education",
    "social-platform"
  ],
  "author": "Pradip Kale",
  "license": "ISC",
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.8",
    "three": "^0.184.0",
    "web-push": "^3.6.7",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "cypress": "^13.6.2",
    "eslint": "^8.56.0",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
